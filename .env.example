# Food Lens: AI model settings
# This file stays on your computer and is never uploaded to GitHub.
# After editing it, restart the app (npm run dev) so the change is picked up.

# Which AI service to use: "openrouter" or "groq"
LLM_PROVIDER=openrouter

# Paste your OpenRouter key after the = sign (no quotes, no spaces).
# Get one at https://openrouter.ai/keys . It starts with sk-or-
LLM_API_KEY=

# Which model reads the label photos. It must accept images.
# Free OpenRouter models that read images (October 2026):
#   qwen/qwen3.8-27b:free          (default)
#   google/gemma-4-26b-a4b-it:free (faster)
#   google/gemma-4-31b-it:free
# Free models change often. If you get "model not found", pick another from
# https://openrouter.ai/models?input_modalities=image&max_price=0
LLM_MODEL=qwen/qwen3.8-27b:free
